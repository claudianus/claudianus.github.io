---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AgentCanvas from '../components/AgentCanvas.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featured = posts.slice(0, 3);
const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
const fmt = new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<BaseLayout
  title="claudianus — 바이브코딩으로 에이전트 엔진을 만드는 개발자"
  description="AI 에이전트 엔진 superliora를 만드는 claudianus의 포트폴리오와 블로그. 세션 오케스트레이션, 목표 루프, 병렬 워커."
  active="home"
>
  <section class="hero">
    <AgentCanvas />
    <div class="container hero-content">
      <p class="hero-kicker">claudianus@superliora:~$ init --agent-engine</p>
      <h1>
        코드를 넘어, <span class="accent">에이전트가 일하는 방식</span>을 설계합니다
      </h1>
      <p class="hero-support">
        AI 에이전트 엔진 superliora를 만드는 개발자입니다. 세션을 오케스트레이션하고,
        목표를 루프로 돌리고, 작업을 병렬 워커에게 나눠 주는 과정을 바이브코딩으로
        빌드합니다.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#work">포트폴리오 보기</a>
        <a
          class="btn btn-ghost"
          href="https://github.com/claudianus"
          target="_blank"
          rel="noopener noreferrer">GitHub ↗</a
        >
      </div>
    </div>
    <span class="scroll-hint" aria-hidden="true">scroll</span>
  </section>

  <section class="section" id="work">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="index">01</span>
        <h2>선별된 작업</h2>
      </div>

      <div class="bento">
        <article class="card card-showcase" data-reveal>
          <span class="card-eyebrow">AI Agent Engine</span>
          <h3>superliora</h3>
          <p>
            목표 하나를 받아 계획·실행·검증까지 스스로 돌아가는 AI 에이전트 엔진.
            세션을 조율하고, 병렬 워커에게 작업을 나눠 주고, 결과를 추적 가능한
            형태로 되돌려 받습니다.
          </p>
          <ul class="feature-list">
            <li>
              <span class="num">01</span>
              <span><span class="name">세션 오케스트레이션</span> — <span class="desc">여러 에이전트 세션을 하나의 작업 흐름으로 조율</span></span>
            </li>
            <li>
              <span class="num">02</span>
              <span><span class="name">목표 루프</span> — <span class="desc">완료 조건을 검사하며 목표에 수렴할 때까지 반복 실행</span></span>
            </li>
            <li>
              <span class="num">03</span>
              <span><span class="name">작업 분해 · 병렬 워커</span> — <span class="desc">큰 목표를 독립 작업으로 쪼개 동시에 실행</span></span>
            </li>
            <li>
              <span class="num">04</span>
              <span><span class="name">관찰 가능성</span> — <span class="desc">세션 로그와 진행 상태를 실시간으로 추적</span></span>
            </li>
          </ul>
          <svg class="flow-diagram" viewBox="0 0 520 96" role="img" aria-label="superliora 작업 흐름 다이어그램: 목표에서 계획, 병렬 워커, 병합으로 이어지는 흐름">
            <path class="wire" d="M92 48 H128 M232 24 H268 M232 72 H268 M368 48 H404" fill="none" />
            <rect class="box" x="8" y="34" width="84" height="28" rx="6" />
            <text x="50" y="52" text-anchor="middle">goal</text>
            <rect class="box" x="128" y="34" width="104" height="28" rx="6" />
            <text x="180" y="52" text-anchor="middle">planner</text>
            <rect class="box" x="268" y="10" width="100" height="28" rx="6" />
            <text x="318" y="28" text-anchor="middle">worker-a</text>
            <rect class="box" x="268" y="58" width="100" height="28" rx="6" />
            <text x="318" y="76" text-anchor="middle">worker-b</text>
            <rect class="box" x="404" y="34" width="100" height="28" rx="6" />
            <text x="454" y="52" text-anchor="middle">merge</text>
            <path class="wire" d="M318 38 V58 M404 76 C 388 76 384 62 404 62 M404 20 C 388 20 384 34 404 34" fill="none" />
          </svg>
          <div class="tag-row">
            <span class="tag">TypeScript</span>
            <span class="tag">Agent Orchestration</span>
            <span class="tag">GitHub Actions</span>
            <span class="tag">Node.js</span>
          </div>
        </article>

        <div class="card-stack">
          <article class="card card-tile" data-reveal>
            <span class="card-eyebrow">This Site</span>
            <h3>claudianus.dev 홈페이지</h3>
            <p>
              Astro 5 콘텐츠 컬렉션 기반의 포트폴리오 · 블로그. 이미지 의존 없이
              Canvas · SVG · CSS만으로 시각화했습니다.
            </p>
            <div class="tag-row">
              <span class="tag">Astro 5</span>
              <span class="tag">Canvas 2D</span>
            </div>
          </article>
          <article class="card card-tile" data-reveal>
            <span class="card-eyebrow">Open Source</span>
            <h3>GitHub 실험실</h3>
            <p>진행 중인 실험과 superliora 개발 기록이 공개되어 있습니다.</p>
            <a
              class="tile-link"
              href="https://github.com/claudianus"
              target="_blank"
              rel="noopener noreferrer">github.com/claudianus</a
            >
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="blog">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="index">02</span>
        <h2>최근 기록</h2>
      </div>
      <ul class="post-list" data-reveal>
        {
          featured.map((post) => (
            <li class="post-row">
              <time datetime={post.data.pubDate.toISOString()}>
                {fmt.format(post.data.pubDate)}
              </time>
              <div>
                <h3>{post.data.title}</h3>
                <span class="excerpt">{post.data.description}</span>
              </div>
              <a
                class="arrow"
                href={`${base}/blog/${post.id}/`}
                aria-label={`${post.data.title} 읽기`}
              >
                →
              </a>
            </li>
          ))
        }
      </ul>
      <p style="margin-top: 1.6rem">
        <a class="mono" href={`${base}/blog/`} style="color: var(--accent)">전체 글 보기 →</a>
      </p>
    </div>
  </section>

  <section class="section" id="about">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="index">03</span>
        <h2>소개 · 연락</h2>
      </div>
      <div class="about-grid">
        <div class="bio" data-reveal>
          <p>
            <strong>claudianus</strong>는 바이브코딩으로 도구를 만드는 개발자입니다.
            AI 에이전트 엔진 <strong>superliora</strong>에서 세션 오케스트레이션,
            목표 루프, 작업 분해와 병렬 워커 설계를 담당합니다.
          </p>
          <p>
            "사람이 코드를 다 쓰던 시대"와 "에이전트가 코드를 쓰는 시대" 사이에서,
            의도를 정확한 사양으로 바꾸는 방법을 실험하고 기록합니다. 좋은 에이전트
            시스템은 좋은 관찰 가능성에서 나온다고 믿습니다.
          </p>
        </div>
        <div class="contact-card" data-reveal>
          <span class="label">Contact</span>
          <p>가장 빠른 연락 경로는 GitHub입니다. 프로젝트 이야기, 협업 제안 모두 환영합니다.</p>
          <a
            class="btn btn-primary"
            href="https://github.com/claudianus"
            target="_blank"
            rel="noopener noreferrer"
          >
            github.com/claudianus ↗
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
