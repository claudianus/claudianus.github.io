---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
const fmt = new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<BaseLayout
  title="블로그 — claudianus"
  description="바이브코딩과 AI 에이전트 개발에 대한 기록."
  active="blog"
>
  <header class="page-header container">
    <p class="mono">~/blog</p>
    <h1>기록</h1>
    <p>바이브코딩 회고와 superliora 개발 과정에서 배운 것들을 적습니다.</p>
  </header>

  <section class="section container" style="padding-top: 3rem">
    <ul class="post-list">
      {
        posts.map((post) => (
          <li class="post-row">
            <time datetime={post.data.pubDate.toISOString()}>
              {fmt.format(post.data.pubDate)}
            </time>
            <div>
              <h3>{post.data.title}</h3>
              <span class="excerpt">{post.data.description}</span>
              <span class="excerpt mono" style="margin-top: 0.6rem">
                {post.data.tags.map((tag) => `#${tag}`).join(' ')}
              </span>
            </div>
            <a
              class="arrow"
              href={`${base}/blog/${post.id}/`}
              aria-label={`${post.data.title} 읽기`}
            >
              →
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
